{
  "manifest_version": 3,
  "name": "DMS Bulk Accept & Complete",
  "version": "1.0.0",
  "description": "Adds batch selection and automated bulk processing (Accept on Incoming & Complete on Pending) for DILG DMS.",
  "homepage_url": "https://luisitovelasco.netlify.app/",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dms.dilg.gov.ph/documentroute/incoming-document*",
        "https://dms.dilg.gov.ph/documentroute/received-documents*",
        "https://dms.dilg.gov.ph/documentreceive/pending*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}